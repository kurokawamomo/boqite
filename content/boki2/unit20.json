      "questions": [
        {
          "stimulus": {
            "text": "連結会計の言葉を、意味と組み合わせてください。"
          },
          "task": {
            "kind": "match",
            "pairs": [
              [
                "親会社",
                "他の会社を支配している会社"
              ],
              [
                "子会社",
                "親会社に支配されている会社"
              ],
              [
                "非支配株主",
                "親会社以外の子会社の株主"
              ],
              [
                "連結財務諸表",
                "親会社と子会社を1つの会社のように表す財務諸表"
              ]
            ]
          },
          "explanation": "親会社が子会社を支配しているとき、2つを1つの会社のように表して連結します。",
          "source": "original",
          "id": "b2-u20-n1-q1",
          "sanitized": true
        },
        {
          "stimulus": {
            "text": "原則として、他の会社の議決権の何％を超えて持つと、その会社を支配しているとみなすか。"
          },
          "task": {
            "kind": "choice",
            "options": [
              "30％",
              "100％",
              "20％",
              "50％"
            ],
            "answerIndex": 3
          },
          "explanation": "議決権の過半数（50％を超える）を持つと、支配しているとみなします。",
